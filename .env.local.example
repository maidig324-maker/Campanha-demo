# Supabase — chaves novas (recomendado). Pegue em Project Settings > API Keys
# > "Publishable and secret API keys". A publishable é segura para o navegador;
# a secret NUNCA pode ter o prefixo NEXT_PUBLIC_ nem ser exposta a Client Components.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Compatibilidade com projetos Supabase que ainda não migraram para as chaves
# novas: se as variáveis acima não estiverem definidas, o app usa estas como
# equivalente legado (mesmo comportamento, formato JWT antigo).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Cloudflare Turnstile — obrigatório para criar reservas (a Server Action
# recusa a reserva se a chave secreta não estiver configurada). Crie um site
# em https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000

# Nunca coloque valores reais deste arquivo no Git — ele é só o modelo.
# Copie para .env.local (já ignorado pelo .gitignore) e preencha lá.
